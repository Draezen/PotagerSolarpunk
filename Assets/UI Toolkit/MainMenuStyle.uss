:root {
}

.header {
    -unity-text-align: upper-center;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 650%;
    color: rgb(255, 235, 4);
    margin-bottom: 60px;
    -unity-text-outline-width: 5px;
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-font-style: bold;
}

.button {
    width: 260px;
    height: 80px;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    color: rgb(255, 255, 255);
    font-size: 48px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
}

.button:hover {
    scale: 1.1 1.1;
    transition-property: scale;
    transition-duration: 0.25s;
    transition-timing-function: ease-in-out;
    transition-delay: 0s;
}

.button:focus {
    scale: 1.1 1.1;
    transition-property: scale;
    transition-duration: 0.25s;
    transition-timing-function: ease-in-out;
    transition-delay: 0s;
}
