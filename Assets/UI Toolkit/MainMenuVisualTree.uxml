<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/MainMenuStyle.uss?fileID=7433441132597879392&amp;guid=425eb48d1f1e42645a213bc7dcffa542&amp;type=3#MainMenuStyle"/>
    <ui:VisualElement name="BGContainer" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/2D/Background.png?fileID=2800000&amp;guid=3010cabd3d17c4540ab2a5f889058705&amp;type=3#Background&quot;); -unity-background-image-tint-color: rgb(229, 229, 229); background-color: rgb(255, 255, 255);">
        <ui:VisualElement name="Page" style="flex-grow: 1; align-self: auto; align-content: auto; margin-top: 120px; margin-right: 120px; margin-bottom: 120px; margin-left: 120px;">
            <ui:Label text="Cray Drone and the Vegetables!" name="Title" class="header"/>
            <ui:VisualElement name="Menu" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/2D/UI/256x256/panel_2.png?fileID=2800000&amp;guid=1d7501232a26f3d4ba68eb61c8ac5dcf&amp;type=3#panel_2&quot;); padding-top: 8px; padding-right: 8px; padding-bottom: 8px; padding-left: 8px; align-self: center; justify-content: center; height: 296px; -unity-slice-left: 32; -unity-slice-top: 32; -unity-slice-right: 32; -unity-slice-bottom: 32; align-content: auto; align-items: stretch; width: 400px;">
                <ui:Label text="Best score: 0" name="Menu__BestScoreLabel" style="-unity-text-align: upper-center; background-image: url(&quot;project://database/Assets/2D/UI/256x256/panel_title_2.png?fileID=2800000&amp;guid=5d9423aa043d52545974fb6a201dec86&amp;type=3#panel_title_2&quot;); color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/LilitaOne-Regular.ttf?fileID=12800000&amp;guid=b0b25c7081699704f917d02e28f31692&amp;type=3#LilitaOne-Regular&quot;); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 6px; padding-right: 6px; padding-bottom: 6px; padding-left: 6px; -unity-slice-left: 32; -unity-slice-top: 32; -unity-slice-right: 32; -unity-slice-bottom: 32; font-size: 36px;"/>
                <ui:VisualElement name="Menu__BtnContainer" style="flex-grow: 1; margin-top: 0; justify-content: space-around; margin-right: 0; margin-bottom: 0; margin-left: 0; align-self: center; padding-top: 10px; padding-right: 0; padding-bottom: 10px; padding-left: 0;">
                    <ui:Button text="Play" name="Menu__PlayBtn" selectable="true" triple-click-selects-line="false" double-click-selects-word="false" class="button" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; background-image: url(&quot;project://database/Assets/2D/UI/256x256/button_green_default_2.png?fileID=2800000&amp;guid=8b572ed8117047647b2d3d47940bb1b9&amp;type=3#button_green_default_2&quot;); -unity-slice-left: 0; -unity-slice-top: 0; -unity-slice-right: 0; -unity-slice-bottom: 0;"/>
                    <ui:Button text="Quit" name="Menu__QuitBtn" selectable="true" double-click-selects-word="false" triple-click-selects-line="false" class="button" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; background-image: url(&quot;project://database/Assets/2D/UI/256x256/button_red_default_2.png?fileID=2800000&amp;guid=e7cc71f7591cdfc4584df69c9acce28a&amp;type=3#button_red_default_2&quot;);"/>
                </ui:VisualElement>
